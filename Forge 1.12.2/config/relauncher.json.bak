// Cleanroom Relauncher configuration
// This file is parsed leniently; comments are allowed and preserved on save.

{
  // Cleanroom version to launch (auto-selected on first run)
  "selectedVersion": "0.5.12-alpha",
  // Latest Cleanroom version seen by the relauncher (informational)
  "latestVersion": "0.5.12-alpha",
  // Preferred Java vendor: "adoptium" (Temurin) or "graalvm" (GraalVM Community JDK).
  // If chosen vendor is unavailable for your OS/arch/version, the relauncher falls back to Adoptium automatically.
  "javaVendor": "adoptium",
  // Java major version to use (e.g., 25). Changing this triggers auto re-download and switch.
  "javaVersion": 25,
  // UI theme: dark mode on/off (default: true). When enabled, all relauncher UI uses a dark theme.
  "darkMode": true,
  // Automatically switch to the latest Cleanroom release on launch.
  // When true, the relauncher will always select the latest release, skipping update prompts.
  "autoUpdate": false,
  // Disable the cache TTL (Time To Live). If true, the list of Cleanroom releases won't be refetched if already cached.
  "disableCacheTTL": false,
  // Directory where downloaded files (Java, Cleanroom, etc.) will be cached.
  "cacheDir": "C:\\Users\\Koteo\\.cleanroom\\relauncher",
  // Optional absolute path to a Java executable. Leave null/empty to let the relauncher manage Java automatically.
  "javaPath": "C:\\Users\\Koteo\\.cleanroom\\relauncher\\java\\temurin-25-windows-x64\\jdk-25-jre\\bin\\java.exe",
  // Optional JVM arguments appended when launching Cleanroom.
  "args": "-XX:+UseZGC -XX:+ZGenerational -XX:+UseCompactObjectHeaders -XX:MaxMetaspaceSize=1G -XX:+ParallelRefProcEnabled -XX:InitiatingHeapOccupancyPercent=44 -XX:MaxTenuringThreshold=8 -XX:+DisableExplicitGC -XX:+UseStringDeduplication -Dfile.encoding=UTF-8 -Dsun.rmi.dgc.server.gcInterval=2147483646 -Dsun.java2d.d3d=false -Dsun.java2d.noddraw=true -Dfml.ignoreInvalidMinecraftCertificates=true -Dfml.ignorePatchDiscrepancies=true -Dfml.doNotBackup=true -Dforge.forceNoStencil=true -Djava.io.tmpdir=C:\Temp\MinecraftTemp -Dforge.forceAsyncChunkLoading=true"
}
