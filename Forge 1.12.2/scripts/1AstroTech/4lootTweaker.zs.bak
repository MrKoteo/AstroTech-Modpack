import loottweaker.LootTweaker;
import loottweaker.LootTable;
import loottweaker.LootPool;
import loottweaker.Conditions;
//import crafttweaker.item.IItemStack;

//mods.loottweaker.LootTable.removePool(tableName, poolName);

val metsLootTable = LootTweaker.getTable("mets:mets_loot");
val metsLootPool = metsLootTable.getPool("mets_loot");


metsLootPool.removeEntry("mets:nano_living_metal");
metsLootPool.removeEntry("mets:titanium_dust");
metsLootPool.addItemEntry(
	<mets:titanium_dust>, // Добавляем элемент
	2, // Вес (шанс генерации)
	0, // Качество по умолчанию
	[{
		"count": {
			"min": 0.0,
			"max": 3.0 // Максимальное количество, которое может выпасть
		},
		"function": "minecraft:set_count" // Функция для задания количества
	}],
	[]
	"titanium_dust" // Название элемента
);


