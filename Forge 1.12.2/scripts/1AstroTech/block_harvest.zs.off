// helper-функция: возвращает true если pattern совпадает с blockId:blockMeta
function matchesPattern(blockId as string, blockMeta as int, pattern as string) as bool {
    // разбиваем pattern по ':'
    var parts as string[] = pattern.split(":");
    if (parts.length == 0) {
        return false;
    }
    // собираем id из первых двух частей (если pattern вида mod:base:id? учтите только mod:id)
    var patId as string = parts[0];
    if (parts.length >= 2) {
        patId = parts[0] + ":" + parts[1];
    }
    if (patId != blockId) {
        return false;
    }
    // если нет третьей части — значит мета не указана => любое meta подходит
    if (parts.length < 3) {
        return true;
    }
    var patMetaStr as string = parts[2];
    if (patMetaStr == "*") {
        return true;
    }
    // пытаемся сравнить числовую мету
    var patMeta as int = patMetaStr as int;
    return (blockMeta == patMeta);
}

